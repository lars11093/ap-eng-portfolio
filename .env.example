# Copy this file to `.env` for local use, and add the same values in the Vercel
# dashboard under Settings -> Environment Variables.
# Never commit the filled-in .env file — .gitignore already excludes it.

# Password for the /admin editor. Choose something long.
ADMIN_PASSWORD=

# Random string used to sign the admin session cookie.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_SECRET=

# --- Only needed for the ONLINE admin (writing entries from the deployed site) ---
# Local `npm run dev` writes files straight to disk and ignores these.

# GitHub fine-grained personal access token.
# Scope it to THIS repository only, with "Contents: Read and write".
GITHUB_TOKEN=

# owner/repo — for example: your-username/ap-eng-portfolio
GITHUB_REPO=

# Branch the admin commits to.
GITHUB_BRANCH=main
