---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { COOKIE_NAME, isConfigured, isValidSession } from '../lib/auth';
import { env, isDev } from '../lib/env';
import { site } from '../site';

export const prerender = false;

const configured = isConfigured();
const signedIn =
  configured && (await isValidSession(Astro.cookies.get(COOKIE_NAME)?.value));

const today = new Date().toISOString().slice(0, 10);
const onlineReady = Boolean(env('GITHUB_TOKEN') && env('GITHUB_REPO'));
const mode = isDev ? 'Local' : 'Online';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Editor — {site.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
  </head>

  <body class="admin">
    <header class="admin__bar">
      <div class="admin__brand">
        <span class="admin__dot" aria-hidden="true"></span>
        Portfolio editor
      </div>

      <div class="admin__bar-right">
        <span class="admin__badge" data-mode={mode.toLowerCase()}>{mode}</span>
        <a class="admin__link" href="/">View site</a>
        {
          signedIn && (
            <form method="post" action="/api/logout">
              <button class="admin__link admin__link--button" type="submit">
                Sign out
              </button>
            </form>
          )
        }
      </div>
    </header>

    <main class="admin__main">
      {
        !configured && (
          <div class="admin__panel">
            <h1 class="admin__h1">The editor is not set up yet</h1>
            <p class="admin__lede">
              Two environment variables are missing. Copy <code>.env.example</code> to
              <code>.env</code>, fill in both values, and restart the dev server.
            </p>
            <ul class="admin__checklist">
              <li>
                <code>ADMIN_PASSWORD</code> — the password for this page.
              </li>
              <li>
                <code>ADMIN_SECRET</code> — a random string that signs your session
                cookie.
              </li>
            </ul>
            <p class="admin__lede">
              For the deployed site, add the same two in the Vercel dashboard under
              Settings &rsaquo; Environment Variables.
            </p>
          </div>
        )
      }

      {
        configured && !signedIn && (
          <div class="admin__panel admin__panel--narrow">
            <h1 class="admin__h1">Sign in</h1>
            <p class="admin__lede">This page writes entries into your portfolio.</p>

            <form class="admin__form" id="login-form">
              <label class="field">
                <span class="field__label">Password</span>
                <input
                  class="field__input"
                  type="password"
                  name="password"
                  autocomplete="current-password"
                  required
                  autofocus
                />
              </label>
              <button class="btn" type="submit">Sign in</button>
              <p class="admin__status" id="login-status" role="status" aria-live="polite" />
            </form>
          </div>
        )
      }

      {
        signedIn && (
          <form class="editor" id="entry-form">
            <div class="editor__head">
              <h1 class="admin__h1">New entry</h1>
              <p class="admin__lede">
                {isDev
                  ? 'Saves straight into src/content/entries/ on this machine.'
                  : onlineReady
                    ? 'Saves by committing to GitHub. Vercel rebuilds automatically.'
                    : 'Add GITHUB_TOKEN and GITHUB_REPO in Vercel before saving from here.'}
              </p>
            </div>

            <label class="field">
              <span class="field__label">Title</span>
              <input
                class="field__input field__input--title"
                name="title"
                id="f-title"
                required
                placeholder="Writing a Job Application in English"
              />
              <span class="field__hint" id="slug-hint" />
            </label>

            <div class="field-row">
              <label class="field">
                <span class="field__label">Date</span>
                <input class="field__input" type="date" name="date" id="f-date" value={today} required />
              </label>

              <label class="field field--check">
                <input type="checkbox" name="draft" id="f-draft" />
                <span>
                  Draft — visible locally, hidden on the published site
                </span>
              </label>
            </div>

            <label class="field">
              <span class="field__label">Summary</span>
              <textarea
                class="field__input"
                name="summary"
                id="f-summary"
                rows="2"
                required
                placeholder="One sentence that tells the reader what this entry is about."
              />
            </label>

            <label class="field">
              <span class="field__label">Tags</span>
              <input class="field__input" name="tags" id="f-tags" placeholder="reflection, writing" />
              <span class="field__hint">Separated by commas.</span>
            </label>

            <div class="field">
              <div class="field__bar">
                <span class="field__label">Entry</span>
                <div class="field__tools">
                  <button class="chip" type="button" data-md="**" data-wrap>Bold</button>
                  <button class="chip" type="button" data-md="_" data-wrap>Italic</button>
                  <button class="chip" type="button" data-md="## ">Heading</button>
                  <button class="chip" type="button" data-md="> ">Quote</button>
                  <label class="chip chip--file">
                    Image
                    <input type="file" id="f-image" accept="image/*" hidden />
                  </label>
                  <button class="chip" type="button" id="toggle-preview" aria-pressed="false">
                    Preview
                  </button>
                </div>
              </div>

              <textarea
                class="field__input field__input--body"
                name="body"
                id="f-body"
                rows="18"
                required
                placeholder="Markdown. Use ## for headings, **bold**, and - for lists."
              />

              <div class="preview prose" id="preview" hidden />
            </div>

            <fieldset class="repeater">
              <legend class="field__label">Sources</legend>
              <p class="field__hint">
                Anything you read, watched or quoted. Leave empty if the entry is
                entirely your own work.
              </p>
              <div id="sources" />
              <button class="chip" type="button" id="add-source">Add a source</button>
            </fieldset>

            <label class="field">
              <span class="field__label">How I used AI</span>
              <textarea
                class="field__input"
                name="aiUse"
                id="f-ai"
                rows="4"
                required
                placeholder="Be specific. If you used no AI for this entry, write that."
              />
              <span class="field__hint">
                Required — this is one of the four things the portfolio is graded on.
              </span>
            </label>

            <div class="editor__actions">
              <button class="btn" type="submit" id="save">Save entry</button>
              <p class="admin__status" id="status" role="status" aria-live="polite" />
            </div>
          </form>
        )
      }
    </main>
  </body>
</html>

<style>
  .admin { background: var(--paper); min-height: 100vh; }

  .admin__bar {
    background: var(--ink);
    color: var(--ink-text);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem clamp(1rem, 4vw, 2rem);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .admin__brand {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--s-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .admin__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
  }

  .admin__bar-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .admin__badge {
    font-family: var(--f-mono);
    font-size: var(--s-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--ink-rule);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    color: var(--ink-muted);
  }

  .admin__badge[data-mode='online'] {
    border-color: var(--signal);
    color: var(--signal);
  }

  .admin__link {
    font-family: var(--f-mono);
    font-size: var(--s-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }

  .admin__link:hover { color: var(--ink-text); }

  .admin__main {
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 3rem) clamp(1rem, 4vw, 2rem) 6rem;
  }

  .admin__panel--narrow { max-width: 26rem; }

  .admin__h1 {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--s-xl);
    letter-spacing: -0.015em;
    text-transform: uppercase;
    line-height: 1.05;
  }

  .admin__lede {
    color: var(--text-muted);
    font-size: var(--s-sm);
    margin-top: 0.625rem;
    max-width: 52ch;
  }

  .admin__lede code,
  .admin__checklist code {
    font-family: var(--f-mono);
    font-size: 0.9em;
    background: var(--paper-2);
    padding: 0.1em 0.35em;
  }

  .admin__checklist {
    margin-top: 1rem;
    padding-left: 1.1rem;
    font-size: var(--s-sm);
    color: var(--text-muted);
    display: grid;
    gap: 0.5rem;
  }

  .admin__form { margin-top: 1.75rem; display: grid; gap: 1rem; }

  .admin__status {
    font-family: var(--f-mono);
    font-size: var(--s-xs);
    line-height: 1.6;
    color: var(--text-muted);
    white-space: pre-line;
  }

  .admin__status[data-tone='error'] { color: var(--signal); }
  .admin__status[data-tone='ok'] { color: var(--text); }

  /* ---- form primitives ---- */
  .editor { display: grid; gap: 1.75rem; }

  .editor__head { margin-bottom: 0.25rem; }

  .field { display: grid; gap: 0.4rem; }

  .field__label {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: var(--s-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
  }

  .field__hint {
    font-family: var(--f-mono);
    font-size: var(--s-xs);
    color: var(--text-muted);
  }

  .field__input {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.625rem 0.75rem;
    font-family: var(--f-body);
    font-size: var(--s-base);
    width: 100%;
  }

  .field__input:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 1px;
    border-color: transparent;
  }

  .field__input--title {
    font-family: var(--f-body);
    font-weight: 600;
    font-size: var(--s-md);
  }

  .field__input--body {
    font-family: var(--f-mono);
    font-size: var(--s-sm);
    line-height: 1.65;
    resize: vertical;
    min-height: 20rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) 1fr;
    gap: 1.25rem;
    align-items: end;
  }

  @media (max-width: 34rem) {
    .field-row { grid-template-columns: 1fr; align-items: start; }
  }

  .field--check {
    grid-auto-flow: column;
    justify-content: start;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--s-sm);
    color: var(--text-muted);
    padding-bottom: 0.6rem;
  }

  .field__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .field__tools { display: flex; flex-wrap: wrap; gap: 0.375rem; }

  .chip {
    font-family: var(--f-mono);
    font-size: var(--s-xs);
    letter-spacing: 0.06em;
    background: none;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    cursor: pointer;
    color: var(--text-muted);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .chip:hover { border-color: var(--rule-strong); color: var(--text); }

  .chip[aria-pressed='true'] {
    border-color: var(--signal);
    color: var(--signal);
  }

  .chip--file { display: inline-flex; align-items: center; }

  .preview {
    border: 1px dashed var(--rule-strong);
    padding: 1.25rem;
    background: var(--paper);
    max-width: none;
  }

  .repeater {
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 1.25rem;
    display: grid;
    gap: 0.875rem;
    justify-items: start;
  }

  .repeater legend { padding-inline: 0.4rem; }

  #sources { display: grid; gap: 1rem; width: 100%; }

  .source {
    display: grid;
    gap: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .source:last-child { border-bottom: 0; padding-bottom: 0; }

  .source__remove {
    justify-self: start;
    color: var(--signal);
    border-color: transparent;
  }

  .editor__actions {
    display: grid;
    gap: 0.875rem;
    justify-items: start;
    border-top: 2px solid var(--ink);
    padding-top: 1.5rem;
  }

  .btn {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: var(--s-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--ink-text);
    border: 0;
    border-radius: 2px;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
  }

  .btn:hover { background: var(--ink-2); }

  .btn[disabled] { opacity: 0.5; cursor: progress; }
</style>

<script>
  import { marked } from 'marked';
  import { slugify } from '../lib/entry';

  function setStatus(el: HTMLElement | null, text: string, tone: 'ok' | 'error' | '') {
    if (!el) return;
    el.textContent = text;
    if (tone) el.dataset.tone = tone;
    else delete el.dataset.tone;
  }

  /* ---------------- sign in ---------------- */
  const loginForm = document.getElementById('login-form') as HTMLFormElement | null;

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = document.getElementById('login-status');
    const password = (loginForm.elements.namedItem('password') as HTMLInputElement).value;

    setStatus(status, 'Checking…', '');

    const response = await fetch('/api/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password }),
    });
    const data = await response.json();

    if (response.ok) {
      location.reload();
    } else {
      setStatus(status, data.error ?? 'Sign in failed.', 'error');
    }
  });

  /* ---------------- editor ---------------- */
  const form = document.getElementById('entry-form') as HTMLFormElement | null;

  if (form) {
    const body = document.getElementById('f-body') as HTMLTextAreaElement;
    const title = document.getElementById('f-title') as HTMLInputElement;
    const slugHint = document.getElementById('slug-hint');
    const preview = document.getElementById('preview') as HTMLElement;
    const previewToggle = document.getElementById('toggle-preview') as HTMLButtonElement;
    const status = document.getElementById('status');
    const saveButton = document.getElementById('save') as HTMLButtonElement;
    const sourcesHost = document.getElementById('sources') as HTMLElement;

    /* web address preview */
    const updateSlug = () => {
      const slug = slugify(title.value);
      if (slugHint) {
        slugHint.textContent = slug ? `Web address: /entries/${slug}/` : '';
      }
    };
    title.addEventListener('input', updateSlug);

    /* markdown toolbar */
    const insert = (token: string, wrap: boolean) => {
      const { selectionStart: start, selectionEnd: end, value } = body;
      const selected = value.slice(start, end);

      const replacement = wrap
        ? `${token}${selected || 'text'}${token}`
        : `${token}${selected}`;

      body.setRangeText(replacement, start, end, 'end');
      body.focus();
      renderPreview();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-md]').forEach((button) => {
      button.addEventListener('click', () => {
        insert(button.dataset.md ?? '', button.hasAttribute('data-wrap'));
      });
    });

    /* preview */
    function renderPreview() {
      if (preview.hidden) return;
      preview.innerHTML = marked.parse(body.value) as string;
    }

    previewToggle.addEventListener('click', () => {
      preview.hidden = !preview.hidden;
      previewToggle.setAttribute('aria-pressed', String(!preview.hidden));
      renderPreview();
    });

    body.addEventListener('input', renderPreview);

    /* image upload */
    const imageInput = document.getElementById('f-image') as HTMLInputElement;

    imageInput.addEventListener('change', async () => {
      const file = imageInput.files?.[0];
      if (!file) return;

      setStatus(status, `Uploading ${file.name}…`, '');

      const payload = new FormData();
      payload.append('file', file);

      const response = await fetch('/api/upload', { method: 'POST', body: payload });
      const data = await response.json();
      imageInput.value = '';

      if (!response.ok) {
        setStatus(status, data.error ?? 'Upload failed.', 'error');
        return;
      }

      const alt = file.name.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ');
      body.setRangeText(
        `\n\n![${alt}](${data.url})\n\n`,
        body.selectionStart,
        body.selectionEnd,
        'end',
      );
      renderPreview();
      setStatus(status, 'Image added to the entry.', 'ok');
    });

    /* sources repeater */
    function addSource() {
      const row = document.createElement('div');
      row.className = 'source';
      row.innerHTML = `
        <input class="field__input" data-source="label" placeholder="Name of the source" />
        <input class="field__input" data-source="url" type="url" placeholder="https://… (optional)" />
        <input class="field__input" data-source="note" placeholder="What you used it for (optional)" />
        <button class="chip source__remove" type="button">Remove</button>`;

      row.querySelector('button')?.addEventListener('click', () => row.remove());
      sourcesHost.append(row);
      row.querySelector('input')?.focus();
    }

    document.getElementById('add-source')?.addEventListener('click', addSource);

    function collectSources() {
      return [...sourcesHost.querySelectorAll('.source')].map((row) => {
        const read = (key: string) =>
          (row.querySelector(`[data-source="${key}"]`) as HTMLInputElement)?.value.trim();
        return { label: read('label'), url: read('url'), note: read('note') };
      });
    }

    /* save */
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      saveButton.disabled = true;
      setStatus(status, 'Saving…', '');

      const value = (id: string) =>
        (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement).value;

      const payload = {
        title: value('f-title'),
        date: value('f-date'),
        summary: value('f-summary'),
        tags: value('f-tags').split(',').map((tag) => tag.trim()).filter(Boolean),
        sources: collectSources().filter((source) => source.label),
        aiUse: value('f-ai'),
        body: value('f-body'),
        draft: (document.getElementById('f-draft') as HTMLInputElement).checked,
      };

      try {
        const response = await fetch('/api/entries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json();

        if (!response.ok) {
          setStatus(status, data.errors ? data.errors.join('\n') : data.error, 'error');
          return;
        }

        setStatus(status, `${data.message}\nSaved as ${data.path}`, 'ok');
        form.reset();
        sourcesHost.replaceChildren();
        updateSlug();
        renderPreview();
      } catch (error) {
        setStatus(status, 'Could not reach the server. Check your connection.', 'error');
      } finally {
        saveButton.disabled = false;
      }
    });
  }
</script>
